{
  "name": "form-and-file-validator",
  "version": "3.21.0",
  "description": "Dependency-free FormValidator (successor of the jQuery Validation plugin), FileValidator and an upload widget",
  "license": "MIT",
  "author": "abu_kalam (https://www.npmjs.com/~abu_kalam)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Kalam031/form-and-file-validator.git"
  },
  "bugs": {
    "url": "https://github.com/Kalam031/form-and-file-validator/issues"
  },
  "homepage": "https://github.com/Kalam031/form-and-file-validator#readme",
  "main": "dist/validator.js",
  "module": "dist/validator.mjs",
  "types": "types/index.d.ts",
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "import": "./dist/validator.mjs",
      "require": "./dist/validator.js",
      "default": "./dist/validator.js"
    },
    "./password": {
      "types": "./types/formValidator.d.ts",
      "default": "./dist/formValidator.password.js"
    },
    "./core": {
      "types": "./types/core.d.ts",
      "import": "./dist/formValidator.core.min.mjs",
      "require": "./dist/formValidator.core.min.js",
      "default": "./dist/formValidator.core.min.js"
    },
    "./form": {
      "types": "./types/formValidator.d.ts",
      "default": "./dist/formValidator.js"
    },
    "./file": {
      "types": "./types/fileValidator.d.ts",
      "default": "./dist/fileValidator.js"
    },
    "./server": {
      "types": "./types/server.d.ts",
      "default": "./dist/server.js"
    },
    "./react": {
      "types": "./types/react.d.ts",
      "default": "./dist/integrations/react.mjs"
    },
    "./vue": {
      "types": "./types/vue.d.ts",
      "default": "./dist/integrations/vue.mjs"
    },
    "./angular": {
      "types": "./types/angular.d.ts",
      "default": "./dist/integrations/angular.mjs"
    },
    "./svelte": {
      "types": "./types/svelte.d.ts",
      "default": "./dist/integrations/svelte.mjs"
    },
    "./lit": {
      "types": "./types/lit.d.ts",
      "default": "./dist/integrations/lit.mjs"
    },
    "./solid": {
      "types": "./types/solid.d.ts",
      "default": "./dist/integrations/solid.mjs"
    },
    "./angular-signals": {
      "types": "./types/angular-signals.d.ts",
      "default": "./dist/integrations/angular-signals.mjs"
    },
    "./alpine": {
      "types": "./types/alpine.d.ts",
      "default": "./dist/integrations/alpine.js"
    },
    "./locales/*": "./dist/locales/*",
    "./widget": "./dist/fileValidator.widget.js",
    "./jquery": "./dist/formValidator.jquery.js",
    "./jquery-additional": "./dist/formValidator.additional.js",
    "./types/*": "./types/*",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src",
    "tools",
    "types",
    "!types/typecheck",
    "docs/*.md",
    "spec/form-rules.vectors.json",
    "spec/file-rules.vectors.json",
    "spec/metadata-vectors.json",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "keywords": [
    "validation",
    "form",
    "file",
    "upload",
    "jquery-validation",
    "accessibility",
    "i18n"
  ],
  "sideEffects": [
    "./dist/locales/*",
    "./dist/integrations/alpine.js",
    "./dist/validator.js",
    "./dist/validator.min.js"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "node build.js",
    "pretest": "node build.js",
    "test": "node --test && npm run test:types",
    "test:types": "tsc -p types/typecheck/tsconfig.json",
    "site": "node build.js && node site-build.js",
    "bench": "node build.js && node bench/run.mjs",
    "test:jquery3": "node tests/run-jquery3.js",
    "test:browser": "node build.js && node --test --test-concurrency=1 browser-tests/browser.spec.js"
  },
  "peerDependencies": {
    "@angular/core": ">=21",
    "@angular/forms": ">=14",
    "lit": ">=2",
    "react": ">=17",
    "solid-js": ">=1.6",
    "vue": ">=3"
  },
  "peerDependenciesMeta": {
    "@angular/core": {
      "optional": true
    },
    "@angular/forms": {
      "optional": true
    },
    "lit": {
      "optional": true
    },
    "solid-js": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "vue": {
      "optional": true
    }
  },
  "devDependencies": {
    "@angular/common": "^22.2.1",
    "@angular/compiler": "^22.2.1",
    "@angular/core": "^22.2.1",
    "@angular/forms": "^22.2.1",
    "@angular/platform-browser": "^22.2.1",
    "@fastify/multipart": "^10.1.2",
    "@hono/node-server": "^2.1.3",
    "@hookform/resolvers": "^5.9.1",
    "@koa/multer": "^4.0.0",
    "@koa/router": "^15.7.0",
    "@standard-schema/spec": "^1.1.0",
    "@types/jquery": "^4.0.1",
    "@types/react": "^19.3.0",
    "alpinejs": "^3.17.4",
    "axe-core": "^4.13.0",
    "esbuild": "^0.28.2",
    "express": "^5.2.1",
    "express-fileupload": "^1.5.2",
    "fastify": "^5.12.5",
    "formidable": "^3.5.4",
    "hono": "^4.13.12",
    "jquery": "^4.0.0",
    "jquery-validation": "^1.22.1",
    "jquery3": "npm:jquery@^3.7.1",
    "jsdom": "^26.0.0",
    "koa": "^3.2.1",
    "lit": "^3.3.3",
    "marked": "^15.0.12",
    "multer": "^2.4.0",
    "playwright": "^1.63.0",
    "pristinejs": "^1.1.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-hook-form": "^7.89.0",
    "rxjs": "^7.8.2",
    "solid-js": "^1.9.15",
    "svelte": "^5.57.1",
    "terser": "^5.51.2",
    "typescript": "^7.0.2",
    "valibot": "^1.5.0",
    "vue": "^3.5.43",
    "yup": "^1.7.1"
  }
}
