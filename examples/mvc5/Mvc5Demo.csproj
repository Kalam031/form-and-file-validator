<Project Sdk="Microsoft.NET.Sdk">

  <!--
    A real ASP.NET MVC 5 site (.NET Framework 4.8: System.Web, Razor views, Global.asax).
    Build:  dotnet build        Output goes to bin\ next to Views\ and Web.config, the layout IIS / IIS Express / Mono xsp expect.
    In your own project, reference the NuGet packages FormAndFileValidator and FormAndFileValidator.Mvc5 instead of the two project references below.
  -->
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <OutputType>Library</OutputType>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <OutputPath>bin\</OutputPath>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <RootNamespace>Mvc5Demo</RootNamespace>
    <AssemblyName>Mvc5Demo</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNet.Mvc" Version="5.3.0" />
    <Reference Include="System.Web" />
    <Reference Include="System.ComponentModel.DataAnnotations" />
    <ProjectReference Include="..\..\dotnet\FormAndFileValidator\FormAndFileValidator.csproj" />
    <ProjectReference Include="..\..\dotnet\FormAndFileValidator.Mvc5\FormAndFileValidator.Mvc5.csproj" />
  </ItemGroup>

</Project>
