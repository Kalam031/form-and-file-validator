@model Mvc5Demo.Models.SignupModel
@{
    ViewBag.Title = "Sign up";
}

<h1>Sign up</h1>

@* Server-side errors (ModelState, filled by the [FormRules] attributes) *@
@Html.ValidationSummary(true, "Please fix the errors below.", new { id = "server-summary" })

@using (Html.BeginForm("Signup", "Account", FormMethod.Post, new { id = "signup", novalidate = "novalidate" }))
{
    <p>
        <label for="FirstName">First name</label>
        @Html.TextBoxFor(m => m.FirstName)
        @Html.ValidationMessageFor(m => m.FirstName, null, new { @class = "server-error", data_for = "FirstName" })
    </p>
    <p>
        <label for="Email">Email</label>
        @Html.TextBoxFor(m => m.Email)
        @Html.ValidationMessageFor(m => m.Email, null, new { @class = "server-error", data_for = "Email" })
    </p>
    <p>
        <label for="Password">Password</label>
        @Html.PasswordFor(m => m.Password)
        @Html.ValidationMessageFor(m => m.Password, null, new { @class = "server-error", data_for = "Password" })
    </p>
    <p>
        <label for="ConfirmPassword">Confirm password</label>
        @Html.PasswordFor(m => m.ConfirmPassword)
        @Html.ValidationMessageFor(m => m.ConfirmPassword, null, new { @class = "server-error", data_for = "ConfirmPassword" })
    </p>
    <p>
        <label for="BirthDate">Birth date (d/M/yyyy)</label>
        @Html.TextBoxFor(m => m.BirthDate)
        @Html.ValidationMessageFor(m => m.BirthDate, null, new { @class = "server-error", data_for = "BirthDate" })
    </p>
    <p>
        <label for="Website">Website</label>
        @Html.TextBoxFor(m => m.Website)
        @Html.ValidationMessageFor(m => m.Website, null, new { @class = "server-error", data_for = "Website" })
    </p>
    <button type="submit" id="go">Create account</button>
}

@* The SAME rules the server just used, written from the model's [FormRules] attributes *@
@section scripts {
    <script src="@Url.Content("~/Scripts/validator.min.js")"></script>
    @Html.FormValidatorInit("signup")
}
