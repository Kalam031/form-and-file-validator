<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- netstandard2.0 = .NET Framework 4.6.1+ (ASP.NET MVC 5, Web API 2, WebForms), .NET Core 2.0+ and everything newer -->
    <TargetFrameworks Condition="'$(Tfm)' == ''">netstandard2.0;net8.0;net10.0</TargetFrameworks>
    <TargetFramework Condition="'$(Tfm)' != ''">$(Tfm)</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <RootNamespace>FormAndFileValidator</RootNamespace>
    <AssemblyName>FormAndFileValidator</AssemblyName>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>

    <PackageId>FormAndFileValidator</PackageId>
    <Version>0.1.0</Version>
    <Authors>abu_kalam</Authors>
    <Description>The server side of form-and-file-validator: the same form rules, with the same answers as the JavaScript package, verified against shared conformance vectors. For ASP.NET MVC 5, ASP.NET Core and any .NET.</Description>
    <PackageTags>validation;form;validator;aspnetcore;aspnetmvc;mvc5;dataannotations</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/Kalam031/form-and-file-validator</RepositoryUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'netstandard2.0'">
    <PackageReference Include="System.Text.Json" Version="8.0.5" />
    <PackageReference Include="System.ComponentModel.Annotations" Version="5.0.0" />
  </ItemGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="FormAndFileValidator.Tests" />
  </ItemGroup>

</Project>
